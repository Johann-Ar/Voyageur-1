{
  "name": "voyageur-1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Voyageur 1 — site de découverte du disque d'or de Voyager (1977) : ses 116 images décodées, explorées en volume (WebGL 2, sans dépendance à l'exécution)",
  "scripts": {
